<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoulJemApp.Views.YouTubeSearchSalaWindow"
        Title="YOUTUBE - SALA"
        Background="#0D0D0D" Foreground="White"
        SystemDecorations="None" Topmost="True">
    
    <Grid RowDefinitions="Auto, *">
        <TextBlock Grid.Row="0" Name="TitleText" Text="🔍 RICERCA IN CORSO..." FontSize="40" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="20"/>
        
        <ListBox Grid.Row="1" Name="ResultsList" Background="Transparent" Margin="20" x:CompileBindings="False" IsHitTestVisible="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1A1A1A" CornerRadius="10" Margin="15" Padding="15" BorderBrush="#444" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center">
                            
                            <Image Source="{Binding ThumbnailImage}" Height="220" Stretch="UniformToFill" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                            
                            <TextBlock Text="{Binding Duration, StringFormat='Durata: {0}'}" Foreground="#FF9800" FontSize="18" TextAlignment="Center" Margin="0,10,0,0"/>
                            
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
