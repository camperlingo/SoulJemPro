        public void OnOmniCloudClick(object sender, RoutedEventArgs e)
        {
            var omniBar = this.FindControl<TextBox>("OmniBar");
            var providerSelector = this.FindControl<ComboBox>("ProviderSelector");
            string text = omniBar?.Text ?? "";
            
            if (string.IsNullOrWhiteSpace(text)) return;

            if (File.Exists(text) || text.StartsWith("http"))
            {
                 var addWin = new AddSingerWindow(text);
                 addWin.Show(); 
            }
            else
            {
                string prefix = "ytsearch"; 
                bool showOnTv = (_currentSinger == null); 
                
                var searchWin = new YouTubeSearchWindow(text, prefix, _ytdlpEngine, showOnTv, (selectedUrl) => 
                {
                    Dispatcher.UIThread.Post(() => 
                    {
                        if (!string.IsNullOrEmpty(selectedUrl))
                        {
                            var addWin = new AddSingerWindow(selectedUrl, text);
                            addWin.Show();
                        }
                    });
                });
                
                searchWin.Show(); 
            }
        }

        public void OnOmniBarKeyDown(object sender, KeyEventArgs e) { if (e.Key == Key.Enter) OnOmniCloudClick(sender, e); }
        
