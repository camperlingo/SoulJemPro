        private void UpdateSlider(string sliderName, int percent)
        {
            if (sliderName == "BaseProgressSlider" && _isDraggingBase) return;
            if (sliderName == "RadioProgressSlider" && _isDraggingRadio) return;
            if (sliderName == "RadioProgressSlider" && _isRadioWebStream) percent = 0;

            Dispatcher.UIThread.Post(() =>
            {
                var slider = this.FindControl<Slider>(sliderName);
                if (slider != null) slider.Value = percent;
            });
        }

        private void LoadArchive(string path)
        {
            if (!Directory.Exists(path)) return;
            _currentPath = path;
            _allFiles.Clear();
            try {
                var dirs = Directory.GetDirectories(path).Select(d => "📁 " + Path.GetFileName(d)).OrderBy(d => d);
                foreach(var d in dirs) _allFiles.Add(d);
            } catch {}

            var extensions = new[] { 
                ".mp4", ".mkv", ".avi", ".webm", ".mov", ".flv", ".wmv", ".m4v", ".mpg", ".mpeg", 
                ".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a", ".opus", ".wma",
                ".cdg", ".mid", ".midi", ".kar" 
            };
            try 
            {
                var files = Directory.GetFiles(path).Where(f => extensions.Contains(Path.GetExtension(f).ToLower())).Select(Path.GetFileName).OrderBy(f => f);
                foreach (var file in files) { if (file != null) _allFiles.Add(file); }
                FilterArchive(""); 
            }
            catch { }
        }

        private void FilterArchive(string? searchText)
        {
            ArchiveFiles.Clear();
            var filtered = string.IsNullOrWhiteSpace(searchText) ? _allFiles : _allFiles.Where(f => f.Contains(searchText, StringComparison.OrdinalIgnoreCase));
            foreach (var file in filtered) ArchiveFiles.Add(file);
        }

