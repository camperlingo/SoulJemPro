        public void OnArchiveDoubleTapped(object sender, TappedEventArgs e)
        {
            var listBox = sender as ListBox;
            if (listBox?.SelectedItem is string selectedItem)
            {
                if (selectedItem.StartsWith("📁 "))
                {
                    string folderName = selectedItem.Substring(3); 
                    LoadArchive(Path.Combine(_currentPath, folderName));
                }
                else
                {
                    string fullPath = Path.Combine(_currentPath, selectedItem);
                    var addWin = new AddSingerWindow(fullPath);
                    addWin.Show();
                }
            }
        }

