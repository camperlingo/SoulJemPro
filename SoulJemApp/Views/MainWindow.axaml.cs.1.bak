        public void OnUpdateSystemEnginesClick(object sender, RoutedEventArgs e)
        {
            Console.WriteLine("[SISTEMA] Lancio aggiornamento di sistema e installazione dipendenze...");
            try
            {
                string scriptPath = Path.Combine(Path.GetTempPath(), "souljem_update.sh");
                string scriptContent = "#!/bin/bash\n" +
                                       "echo \"Installazione/Aggiornamento Motori SoulJem (MPV, MIDI, Node.js, wmctrl)...\"\n" +
                                       "sudo apt update && sudo apt install -y mpv fluidsynth timidity nodejs wmctrl\n" +
                                       "echo \"\"\n" +
                                       "echo \"Fatto! Motori al 100%. Premi INVIO per chiudere questa finestra.\"\n" +
                                       "read\n";

                File.WriteAllText(scriptPath, scriptContent);
                Process.Start(new ProcessStartInfo { FileName = "chmod", Arguments = $"+x {scriptPath}", UseShellExecute = false })?.WaitForExit();
                Process.Start(new ProcessStartInfo { FileName = "x-terminal-emulator", Arguments = $"-e \"{scriptPath}\"", UseShellExecute = false });
            }
            catch (Exception ex) { Console.WriteLine($"Errore avvio terminale: {ex.Message}"); }
        }

