        public void OnCaricaRadioClick(object sender, RoutedEventArgs e)
        {
            string targetUrl = "https://shoutcast.rtl.it/stream1"; 
            var combo = this.FindControl<ComboBox>("RadioStationsCombo");
            if (combo != null && combo.SelectedItem is string selectedName && WebRadios.ContainsKey(selectedName)) targetUrl = WebRadios[selectedName];

            var volSlider = this.FindControl<Slider>("RadioVolumeSlider");
            int currentVol = volSlider != null ? (int)volSlider.Value : 100;

            _isRadioWebStream = targetUrl.StartsWith("http");

            _mpvEngine.PlayRadio(targetUrl, currentVol);
            Console.ForegroundColor = ConsoleColor.Cyan;
            Console.WriteLine($"[SISTEMA] RADIO Sintonizzata su: {targetUrl}");
            Console.ResetColor();
            
            SetRadioPlayPauseState(false); 
        }

        public void OnRadioPlayPauseClick(object sender, RoutedEventArgs e)
        {
            _isRadioPaused = !_isRadioPaused;
            _mpvEngine.TogglePauseRadio(_isRadioPaused);
            SetRadioPlayPauseState(_isRadioPaused);
