        private void SetRadioPlayPauseState(bool isPaused)
        {
            _isRadioPaused = isPaused;
            var btn = this.FindControl<Button>("RadioPlayPauseButton");
            if (btn != null)
            {
                btn.Content = isPaused ? "▶ PLAY RADIO" : "⏸ PAUSA RADIO";
                btn.Background = Avalonia.Media.SolidColorBrush.Parse(isPaused ? "#2E7D32" : "#F57C00"); 
            }
        }

