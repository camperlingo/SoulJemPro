        public MainWindow()
        {
            InitializeComponent();
            CleanupOldWebDownloads();

            _ducking = new DuckingService(_mpvEngine); 
            _radiosFilePath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "radios.json");
            LoadRadios();

            _historyFilePath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "history.json");
            LoadHistory();

            _logoSettingsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "last_logo.txt");
            _vizSettingsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "last_viz.txt");
            _assetsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "assets");
            if (!Directory.Exists(_assetsPath)) Directory.CreateDirectory(_assetsPath);

            _currentPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "Basi_karaoke");
            
            var archiveListControl = this.FindControl<ListBox>("ArchiveList");
            if (archiveListControl != null) archiveListControl.ItemsSource = ArchiveFiles;

            var singerGridControl = this.FindControl<DataGrid>("SingerGrid");
            if (singerGridControl != null) singerGridControl.ItemsSource = SingersQueue;

            var searchBox = this.FindControl<TextBox>("ArchiveSearchBox");
            if (searchBox != null) searchBox.TextChanged += (s, e) => { FilterArchive(searchBox.Text); };

            var baseSlider = this.FindControl<Slider>("BaseProgressSlider");
            if (baseSlider != null) {
                baseSlider.AddHandler(InputElement.PointerPressedEvent, OnBaseSliderPressed, RoutingStrategies.Tunnel);
                baseSlider.AddHandler(InputElement.PointerReleasedEvent, OnBaseSliderReleased, RoutingStrategies.Tunnel);
            }

            var radioSlider = this.FindControl<Slider>("RadioProgressSlider");
            if (radioSlider != null) {
                radioSlider.AddHandler(InputElement.PointerPressedEvent, OnRadioSliderPressed, RoutingStrategies.Tunnel);
                radioSlider.AddHandler(InputElement.PointerReleasedEvent, OnRadioSliderReleased, RoutingStrategies.Tunnel);
            }

            _mpvEngine.OnRadioProgressChanged = (percent) => UpdateSlider("RadioProgressSlider", percent);
            
            _uiTimer = new DispatcherTimer { Interval = TimeSpan.FromMilliseconds(50) }; // Per fluidità Karaoke a 20fps
            _uiTimer.Tick += OnUiTimerTick;

            _webServer.OnSongRequested = (nome, canzone, note) => {
                Dispatcher.UIThread.Post(() => {
                    string titoloCompleto = string.IsNullOrEmpty(note) ? canzone : $"{canzone} [{note}]";
                    SingersQueue.Add(new SingerItem { 
                        Name = nome, 
                        SongTitle = titoloCompleto, 
                        SongPath = "DA CERCARE", 
                        Status = "🔴 DA CERCARE", 
                        ProgressColor = Avalonia.Media.Brushes.Crimson,
                        ProgressValue = 100
                    });
                    Console.ForegroundColor = ConsoleColor.Magenta;
                    Console.WriteLine($"[SMARTPHONE] Nuova richiesta ricevuta dal tavolo! {nome} vuole cantare {canzone}");
                    Console.ResetColor();
                });
            };
            _webServer.Start(8080);

            LoadArchive(_currentPath);
            LoadLastLogo(); 
            CheckPitchUnlockStatus();
            Console.WriteLine("[SISTEMA] Interfaccia caricata e pronta!");
            
            _ = _ytdlpEngine.UpdateYtdlpAsync();
        }

        private void OnUiTimerTick(object? sender, EventArgs e)
        {
            if (_liteEngine != null && !_isPreviewPaused && !_isDraggingBase)
            {
                double duration = _liteEngine.TotalDuration;
                double current = _liteEngine.CurrentTime;

                if (duration > 1.0) 
                {
                    double percent = (current / duration) * 100;
                    UpdateSlider("BaseProgressSlider", (int)percent);
                    
                    if (current >= duration - 0.2) 
                    {
                        _uiTimer.Stop();
                        Dispatcher.UIThread.Post(() => {
                            UpdateSlider("BaseProgressSlider", 0);
                            OnPreviewStopClick(this, new RoutedEventArgs()); 
                            Console.WriteLine("[SISTEMA] Base terminata (EOF)! Ripristino la Radio...");
                        });
                    }
                }
                else
                {
                    UpdateSlider("BaseProgressSlider", 0);
                }

                // --- IL NUOVO CABLAGGIO PER IL TESTO SYLT HD ---
                var previewScreen = this.FindControl<PreviewControl>("VideoSurface");
                if (previewScreen != null)
                {
                    previewScreen.CurrentTime = current;
                    previewScreen.InvalidateVisual();
                }
                if (_publicScreen != null)
                {
                    _publicScreen.CurrentTime = current;
                    _publicScreen.InvalidateVisual();
                }
            }
        }

        public void OnQrCodeClick(object sender, RoutedEventArgs e)
        {
            if (_qrWindow != null && _qrWindow.IsVisible)
            {
                _qrWindow.Close();
                _qrWindow = null;
                return;
            }

            Task.Run(async () => {
                string scriptPath = Path.Combine(Path.GetTempPath(), "souljem_firewall.sh");
                string scriptContent = "#!/bin/bash\n" +
                                       "echo \"GESTIONE FIREWALL SOULJEM\"\n" +
                                       "echo \"--------------------------\"\n" +
                                       "echo \"1) APRI (Abilita prenotazioni smartphone)\"\n" +
                                       "echo \"2) CHIUDI (Massima sicurezza PC)\"\n" +
                                       "echo \"3) SALTA (Mostra solo il QR Code attuale)\"\n" +
                                       "read -p \"Scegli opzione: \" scelta\n" +
                                       "if [ \"$scelta\" == \"1\" ]; then\n" +
                                       "  sudo ufw allow 8080/tcp\n" +
                                       "  echo \"PORTA 8080 APERTA. Servizio attivo.\"\n" +
                                       "elif [ \"$scelta\" == \"2\" ]; then\n" +
                                       "  sudo ufw deny 8080/tcp\n" +
                                       "  echo \"PORTA 8080 CHIUSA. Servizio disabilitato.\"\n" +
                                       "fi\n" +
                                       "sleep 1\n";

                File.WriteAllText(scriptPath, scriptContent);
                Process.Start(new ProcessStartInfo { FileName = "chmod", Arguments = $"+x {scriptPath}", UseShellExecute = false })?.WaitForExit();
                var p = Process.Start(new ProcessStartInfo { FileName = "x-terminal-emulator", Arguments = $"-e \"{scriptPath}\"", UseShellExecute = false });
                
                if (p != null) await Task.Run(() => p.WaitForExit());

                Dispatcher.UIThread.Post(() => {
                    string myIp = GetLocalIPAddress();
                    string webAppUrl = $"http://{myIp}:8080"; 
                    _qrWindow = new QrCodeWindow(webAppUrl);
                    _qrWindow.Show();
                });
            });
        }

        private async void LoadLastLogo()
        {
            if (File.Exists(_logoSettingsPath))
            {
                string savedPath = File.ReadAllText(_logoSettingsPath).Trim();
                if (File.Exists(savedPath))
                {
                    _currentBackgroundImage = savedPath;
                    await Task.Delay(2000); 
                    Dispatcher.UIThread.Post(() => {
                        if (!string.IsNullOrEmpty(_currentBackgroundImage) && !_isVizOn) 
                            StartPreviewEmbedded(_currentBackgroundImage, false, false);
                    });
                }
            }
        }

        private void LoadRadios()
        {
            WebRadios.Clear();
            if (File.Exists(_radiosFilePath))
            {
                try {
                    string json = File.ReadAllText(_radiosFilePath);
                    var list = JsonSerializer.Deserialize<ObservableCollection<RadioItem>>(json);
                    if (list != null) { foreach (var r in list) WebRadios[r.Name] = r.Url; }
                } catch { }
            }
            if (WebRadios.Count == 0) {
                WebRadios.Add("RTL 102.5", "https://shoutcast.rtl.it/stream1");
                WebRadios.Add("RDS", "https://icstream.rds.radio/rds");
            }
            UpdateRadioComboBox();
        }

        private void UpdateRadioComboBox()
        {
            var combo = this.FindControl<ComboBox>("RadioStationsCombo");
            if (combo != null) 
            {
                var currentSelection = combo.SelectedItem as string;
                combo.ItemsSource = WebRadios.Keys.ToList();
                if (currentSelection != null && WebRadios.ContainsKey(currentSelection)) combo.SelectedItem = currentSelection;
                else combo.SelectedIndex = 0;
            }
        }

