        public void OnMoveUpClick(object sender, RoutedEventArgs e)
        {
            var grid = this.FindControl<DataGrid>("SingerGrid");
            if (grid?.SelectedItem is SingerItem selectedItem)
            {
                int index = SingersQueue.IndexOf(selectedItem);
                if (index > 0)
                {
                    SingersQueue.RemoveAt(index);
                    SingersQueue.Insert(index - 1, selectedItem);
                    grid.SelectedItem = selectedItem; 
                }
            }
        }

        public void OnMoveDownClick(object sender, RoutedEventArgs e)
        {
            var grid = this.FindControl<DataGrid>("SingerGrid");
            if (grid?.SelectedItem is SingerItem selectedItem)
            {
                int index = SingersQueue.IndexOf(selectedItem);
                if (index >= 0 && index < SingersQueue.Count - 1)
                {
                    SingersQueue.RemoveAt(index);
                    SingersQueue.Insert(index + 1, selectedItem);
                    grid.SelectedItem = selectedItem; 
                }
            }
        }

        public void OnSingerDoubleTapped(object sender, TappedEventArgs e)
        {
            var grid = sender as DataGrid;
            if (grid?.SelectedItem is SingerItem selectedSinger)
            {
                var editWin = new AddSingerWindow(selectedSinger);
                editWin.Show();
            }
        }

