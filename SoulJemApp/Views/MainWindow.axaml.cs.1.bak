        private void CheckPitchUnlockStatus()
        {
            string statusPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "pitch_status.txt");
            if (File.Exists(statusPath) && File.ReadAllText(statusPath).Trim() == "PASS")
            {
                Dispatcher.UIThread.Post(() => {
                    var pUp = this.FindControl<Button>("PitchUpBtn");
                    var pDown = this.FindControl<Button>("PitchDownBtn");
                    var pRes = this.FindControl<Button>("PitchResetBtn");
                    var pBorder = this.FindControl<Border>("PitchDisplayBorder");
                    var pDisp = this.FindControl<TextBlock>("PitchValueDisplay");

                    if (pUp != null) { pUp.IsEnabled = true; pUp.Opacity = 1.0; }
                    if (pDown != null) { pDown.IsEnabled = true; pDown.Opacity = 1.0; }
                    if (pRes != null) { pRes.IsEnabled = true; }
                    if (pBorder != null) { pBorder.Opacity = 1.0; pBorder.Background = Avalonia.Media.SolidColorBrush.Parse("Black"); }
                    if (pDisp != null) { pDisp.Text = "0"; pDisp.Foreground = Avalonia.Media.SolidColorBrush.Parse("#ffcc00"); pDisp.FontSize = 16; }
                });
            }
        }

        public async void OnBenchmarkClick(object sender, RoutedEventArgs e)
        {
            try
            {
                string scriptPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "SoulJem_v5", "SoulJemApp", "benchmark.sh");
                string tempResultPath = "/tmp/sj_current_test.txt"; 
                
                if (!File.Exists(scriptPath))
                {
                    Console.ForegroundColor = ConsoleColor.Red;
                    Console.WriteLine("[ERRORE] Script benchmark.sh non trovato nella cartella del progetto.");
                    Console.ResetColor();
                    return;
                }

                if (File.Exists(tempResultPath)) File.Delete(tempResultPath);

                Console.WriteLine("[SISTEMA] Avvio Test Hardware in corso...");
                
                var p = Process.Start(new ProcessStartInfo { FileName = "x-terminal-emulator", Arguments = $"-e \"{scriptPath}\"", UseShellExecute = false });
                
                if (p != null) await Task.Run(() => p.WaitForExit()); 

                if (File.Exists(tempResultPath))
                {
                    string result = File.ReadAllText(tempResultPath).Trim();
                    if (result == "PASS")
                    {
                        Dispatcher.UIThread.Post(() => {
                            var pUp = this.FindControl<Button>("PitchUpBtn");
                            var pDown = this.FindControl<Button>("PitchDownBtn");
                            var pRes = this.FindControl<Button>("PitchResetBtn");
                            var pBorder = this.FindControl<Border>("PitchDisplayBorder");
                            var pDisp = this.FindControl<TextBlock>("PitchValueDisplay");

                            if (pUp != null) { pUp.IsEnabled = true; pUp.Opacity = 1.0; }
                            if (pDown != null) { pDown.IsEnabled = true; pDown.Opacity = 1.0; }
                            if (pRes != null) { pRes.IsEnabled = true; }
                            if (pBorder != null) { pBorder.Opacity = 1.0; pBorder.Background = Avalonia.Media.SolidColorBrush.Parse("Black"); }
                            if (pDisp != null) { pDisp.Text = "0"; pDisp.Foreground = Avalonia.Media.SolidColorBrush.Parse("#ffcc00"); pDisp.FontSize = 16; }

                            Console.ForegroundColor = ConsoleColor.Green;
                            Console.WriteLine("[SISTEMA] PITCH LIVE SBLOCCATO! (Accesso Sessione).");
                            Console.ResetColor();
                        });
                    }
                    else
                    {
                        Console.ForegroundColor = ConsoleColor.Red;
                        Console.WriteLine("[SISTEMA] Benchmark Fallito. Hardware non idoneo. Pitch disabilitato per sicurezza.");
                        Console.ResetColor();
                    }
                }
                else
                {
                    Console.WriteLine("[SISTEMA] Test Benchmark annullato dall'utente.");
                }
            }
            catch (Exception ex) { Console.WriteLine($"[ERRORE] {ex.Message}"); }
        }
    }
}
