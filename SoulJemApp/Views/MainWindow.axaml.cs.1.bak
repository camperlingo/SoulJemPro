        public void OnFirewallOpenClick(object sender, RoutedEventArgs e)
        {
            try
            {
                string scriptPath = Path.Combine(Path.GetTempPath(), "firewall_open.sh");
                string scriptContent = "#!/bin/bash\n" +
                                       "echo \"ATTIVAZIONE ACCESSO SMARTPHONE...\"\n" +
                                       "sudo ufw allow 8080/tcp\n" +
                                       "echo \"\"\n" +
                                       "echo \"🔓 FIREWALL APERTO (Porta 8080).\"\n" +
                                       "echo \"Gli smartphone possono ora collegarsi.\"\n" +
                                       "sleep 3\n";

                File.WriteAllText(scriptPath, scriptContent);
                Process.Start(new ProcessStartInfo { FileName = "chmod", Arguments = $"+x {scriptPath}", UseShellExecute = false })?.WaitForExit();
                Process.Start(new ProcessStartInfo { FileName = "x-terminal-emulator", Arguments = $"-e \"{scriptPath}\"", UseShellExecute = false });
            }
            catch (Exception ex) { Console.WriteLine($"Errore: {ex.Message}"); }
        }

        public void OnFirewallCloseClick(object sender, RoutedEventArgs e)
        {
            try
            {
                string scriptPath = Path.Combine(Path.GetTempPath(), "firewall_close.sh");
                string scriptContent = "#!/bin/bash\n" +
                                       "echo \"DISATTIVAZIONE ACCESSO SMARTPHONE...\"\n" +
                                       "sudo ufw deny 8080/tcp\n" +
                                       "echo \"\"\n" +
                                       "echo \"🔒 FIREWALL CHIUSO (Porta 8080).\"\n" +
                                       "echo \"Massima sicurezza ripristinata.\"\n" +
                                       "sleep 3\n";

                File.WriteAllText(scriptPath, scriptContent);
                Process.Start(new ProcessStartInfo { FileName = "chmod", Arguments = $"+x {scriptPath}", UseShellExecute = false })?.WaitForExit();
                Process.Start(new ProcessStartInfo { FileName = "x-terminal-emulator", Arguments = $"-e \"{scriptPath}\"", UseShellExecute = false });
            }
            catch (Exception ex) { Console.WriteLine($"Errore: {ex.Message}"); }
        }

