<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:plugins="clr-namespace:SoulJemApp.Plugins"
        xmlns:models="clr-namespace:SoulJemApp.Models"
        x:Class="SoulJemApp.Views.StudioDownloaderWindow"
        Title="HQ Studio Downloader (Pro Edition)"
        Width="750" Height="620" WindowStartupLocation="CenterOwner"
        Background="#ECEFF1" Foreground="#333"
        x:DataType="models:YouTubeResultItem">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" Margin="15">
        
        <TextBlock Grid.Row="0" Text="🎛️ STUDIO DOWNLOADER HQ" FontSize="20" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#263238" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔍 Ricerca Rapida YouTube" FontWeight="Bold" Foreground="#FFC107" Margin="0,0,0,5"/>
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Name="SearchInput" Watermark="Cerca un brano..." KeyDown="OnSearchKeyDown"/>
                    <Button Grid.Column="1" Name="SearchBtn" Content="Cerca" Click="OnSearchClick" Background="#FF9800" Foreground="Black" FontWeight="Bold" Margin="5,0,0,0"/>
                </Grid>
                <ListBox Name="ResultsList" Height="80" Background="#37474F" Foreground="White" Margin="0,5,0,0" DoubleTapped="OnResultDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:YouTubeResultItem">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="{Binding Duration, StringFormat='[{0}] - '}" Foreground="#4CAF50" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="NoWrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Fai doppio clic su un risultato per caricarlo giù 👇" FontSize="11" Foreground="#90A4AE" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Margin="0,5">
            <TextBlock Grid.Column="0" Text="Salva in:" FontWeight="Bold" VerticalAlignment="Center" Width="80"/>
            <TextBox Grid.Column="1" Name="FolderInput" IsReadOnly="True" Background="#FFF"/>
            <Button Grid.Column="2" Content="📂 Scegli" Click="OnBrowseClick" Margin="5,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,5">
            <TextBlock Text="Fmt:" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox Name="FmtCombo" SelectedIndex="0" Width="80">
                <ComboBoxItem>mp3</ComboBoxItem>
                <ComboBoxItem>m4a</ComboBoxItem>
                <ComboBoxItem>flac</ComboBoxItem>
                <ComboBoxItem>wav</ComboBoxItem>
            </ComboBox>
            
            <TextBlock Text="Bitrate:" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox Name="BitrateCombo" SelectedIndex="0" Width="100">
                <ComboBoxItem>320</ComboBoxItem>
                <ComboBoxItem>256</ComboBoxItem>
                <ComboBoxItem>192</ComboBoxItem>
                <ComboBoxItem>VBR (Auto)</ComboBoxItem>
            </ComboBox>
            
            <TextBlock Text="Hz:" FontWeight="Bold" VerticalAlignment="Center"/>
            <ComboBox Name="HzCombo" SelectedIndex="0" Width="100">
                <ComboBoxItem>48000</ComboBoxItem>
                <ComboBoxItem>44100</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Spacing="5" Margin="0,10">
            <TextBlock Text="Link YouTube:" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" Name="UrlInput" Background="#FFF"/>
                <Button Grid.Column="1" Name="InfoBtn" Content="🔄 Info" Click="OnInfoClick" Background="#1976D2" Foreground="White" FontWeight="Bold" Margin="5,0,0,0"/>
            </Grid>
            
            <TextBlock Text="Nome File (senza estensione):" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBox Name="FileNameInput" Background="#FFF"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Spacing="5" Margin="0,10">
            <Button Name="DownloadBtn" Content="⬇ SCARICA ORA" Click="OnDownloadClick" IsEnabled="False" Background="#B0BEC5" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
            <TextBlock Name="PercentLabel" Text="0%" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
            <ProgressBar Name="DownloadProgress" Height="20" Minimum="0" Maximum="100" Value="0" Foreground="#4CAF50"/>
            <TextBlock Name="StatusLabel" Text="In attesa del link..." HorizontalAlignment="Center" Foreground="#555"/>
        </StackPanel>
    </Grid>
</Window>
