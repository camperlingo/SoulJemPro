<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoulJemApp.Views.HistoryWindow"
        Title="📜 STORICO SERATA"
        Width="800" Height="500"
        CanResize="False" WindowStartupLocation="CenterOwner"
        Background="#1A1A1A" Foreground="White">

    <Grid RowDefinitions="Auto, *, Auto" Margin="15">
        <TextBlock Grid.Row="0" Text="STORICO BRANI CANTATI" FontSize="18" FontWeight="Bold" Foreground="#2196F3" Margin="0,0,0,10" HorizontalAlignment="Center"/>
        
        <DataGrid Grid.Row="1" Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0A0A0A" GridLinesVisibility="Horizontal" HeadersVisibility="Column" x:CompileBindings="False" DoubleTapped="OnHistoryDoubleTapped">
            
            <DataGrid.ContextMenu>
                <ContextMenu Background="#222">
                    <MenuItem Header="💾 Salva Base (Esporta nel PC)..." Click="OnSaveBaseClick" Foreground="White"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Orario" Binding="{Binding Time}" Width="100"/>
                <DataGridTextColumn Header="Cantante" Binding="{Binding SingerName}" Width="*"/>
                <DataGridTextColumn Header="Brano" Binding="{Binding SongTitle}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,15,0,0">
            <Button Grid.Column="0" Content="❌ CHIUDI" Click="CloseButton_Click" Background="#C62828" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
            <Button Grid.Column="1" Content="🔄 RICARICA IN CODA" Click="ReloadButton_Click" Background="#2E7D32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
