<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoulJemApp.Views.YouTubeSearchWindow"
        Title="Risultati Ricerca"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#151515" Foreground="White">

    <Grid RowDefinitions="Auto, *">
        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="15">
            <TextBlock Name="TitleText" Text="🔍 Ricerca in corso..." FontSize="20" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
        </Border>

        <ListBox Grid.Row="1" Name="ResultsList" Background="#0A0A0A" Margin="10" x:CompileBindings="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#222" CornerRadius="8" Margin="5" Padding="10">
                        <Grid ColumnDefinitions="120, *, Auto">
                            <Image Grid.Column="0" Source="{Binding ThumbnailImage}" Width="110" Height="80" Stretch="UniformToFill"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Duration, StringFormat='Durata: {0}'}" Foreground="#FF9800" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="2" Content="SELEZIONA ▶" 
                                    Click="OnSelectClick" CommandParameter="{Binding Url}"
                                    Background="#1565C0" Foreground="White" FontWeight="Bold" 
                                    VerticalAlignment="Center" Padding="15,10"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
