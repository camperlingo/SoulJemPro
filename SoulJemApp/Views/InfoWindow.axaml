<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SoulJemApp.Views.InfoWindow"
        Title="About SoulJem Workstation"
        Width="600" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0A" CanResize="False">

    <Border BorderBrush="#444" BorderThickness="1" Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
            <TextBlock Text="🎙️" FontSize="45" HorizontalAlignment="Center"/>
            <TextBlock Text="SOULJEM WORKSTATION PRO v5.5" FontSize="22" FontWeight="Bold" Foreground="#FFCC00" HorizontalAlignment="Center"/>
            <TextBlock Text="The Ultimate Karaoke &amp; Midi Experience" FontSize="14" Foreground="#29B6F6" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Border Background="#151515" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="20" Margin="15,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Un'opera di ingegneria di altissimo livello." Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="L'applicazione v4.0 è stata interamente riprogettata e trasportata dal Python al potente C# (Avalonia UI), garantendo prestazioni estreme, latenza zero e un design a plancia unica." 
                               TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="12" TextAlignment="Center" Margin="0,0,0,5"/>
                    
                    <Border Height="1" Background="#333" Margin="0,5"/>

                    <TextBlock Text="Sviluppato e regalato alla community da:" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="Emanuele Camperlingo &amp; Gemini 3.1 Pro" Foreground="#00E676" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    
                    <Border Height="1" Background="#333" Margin="0,5"/>

                    <TextBlock Text="Chi vuol fare donazioni per supportare futuri upgrade dell'app, può scrivermi a:" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="✉️ nuvolariuomodonna@gmail.com" Foreground="#FFB300" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Bye! (Ciao!) 👋" Foreground="#888" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5"/>

            <Button Content="CHIUDI" Width="120" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Background="#D32F2F" Foreground="White" FontWeight="Bold" Click="OnCloseClick"/>
        </StackPanel>
    </Border>
</Window>
