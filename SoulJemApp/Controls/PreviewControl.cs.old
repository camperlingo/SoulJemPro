using Avalonia.OpenGL;
using Avalonia.OpenGL.Controls;
using Silk.NET.OpenGL;
using System;

namespace SoulJemApp.Controls
{
    public class PreviewControl : OpenGlControlBase
    {
        private uint _textureId;
        private GL? _gl;
        private uint _program;
        private uint _vao, _vbo;
        private bool _shadersReady;

        private byte[]? _pendingPixels;
        private int _vidWidth, _vidHeight;
        private readonly object _syncLock = new object();

        private const string VertexShader = @"
            #version 330 core
            in vec2 aPosition;
            in vec2 aTexCoord;
            out vec2 vTexCoord;
            void main() {
                gl_Position = vec4(aPosition, 0.0, 1.0);
                vTexCoord = vec2(aTexCoord.x, 1.0 - aTexCoord.y);
            }";

        private const string FragmentShader = @"
            #version 330 core
            in vec2 vTexCoord;
            out vec4 FragColor;
            uniform sampler2D uTexture;
            void main() {
                FragColor = texture(uTexture, vTexCoord);
            }";

        protected override void OnOpenGlInit(GlInterface gl)
        {
            try
            {
                _gl = GL.GetApi(gl.GetProcAddress);
                if (_gl != null) InitShaders();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[AVALONIA GL ERRORE] {ex.Message}");
                _shadersReady = false;
            }
        }

        private unsafe void InitShaders()
        {
            if (_gl == null) return;

            _textureId = _gl.GenTexture();
            _gl.BindTexture(TextureTarget.Texture2D, _textureId);
            _gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMinFilter, (int)TextureMinFilter.Linear);
            _gl.TexParameter(TextureTarget.Texture2D, TextureParameterName.TextureMagFilter, (int)TextureMagFilter.Linear);

            uint vs = _gl.CreateShader(ShaderType.VertexShader);
            _gl.ShaderSource(vs, VertexShader);
            _gl.CompileShader(vs);

            uint fs = _gl.CreateShader(ShaderType.FragmentShader);
            _gl.ShaderSource(fs, FragmentShader);
            _gl.CompileShader(fs);

            _program = _gl.CreateProgram();
            _gl.AttachShader(_program, vs);
            _gl.AttachShader(_program, fs);
            _gl.LinkProgram(_program);
            _shadersReady = true;

            _gl.DeleteShader(vs);
            _gl.DeleteShader(fs);

            float[] vertices = {
                -1.0f, -1.0f,  0.0f, 0.0f,
                 1.0f, -1.0f,  1.0f, 0.0f,
                -1.0f,  1.0f,  0.0f, 1.0f,
                 1.0f,  1.0f,  1.0f, 1.0f
            };

            _vao = _gl.GenVertexArray();
            _gl.BindVertexArray(_vao);
            _vbo = _gl.GenBuffer();
            _gl.BindBuffer(BufferTargetARB.ArrayBuffer, _vbo);
            
            fixed (float* v = vertices)
            {
                _gl.BufferData(BufferTargetARB.ArrayBuffer, (nuint)(vertices.Length * sizeof(float)), v, BufferUsageARB.StaticDraw);
            }

            int posLoc = _gl.GetAttribLocation(_program, "aPosition");
            if (posLoc >= 0)
            {
                _gl.EnableVertexAttribArray((uint)posLoc);
                _gl.VertexAttribPointer((uint)posLoc, 2, VertexAttribPointerType.Float, false, 4 * sizeof(float), (void*)0);
            }

            int texLoc = _gl.GetAttribLocation(_program, "aTexCoord");
            if (texLoc >= 0)
            {
                _gl.EnableVertexAttribArray((uint)texLoc);
                _gl.VertexAttribPointer((uint)texLoc, 2, VertexAttribPointerType.Float, false, 4 * sizeof(float), (void*)(2 * sizeof(float)));
            }
            _gl.BindVertexArray(0);
        }

        // --- IL NUOVO METODO PER RICEVERE IL FOTOGRAMMA ---
        public void PushFrame(byte[] pixels, int width, int height)
        {
            lock (_syncLock)
            {
                _pendingPixels = pixels;
                _vidWidth = width;
                _vidHeight = height;
            }
            Avalonia.Threading.Dispatcher.UIThread.Post(() => RequestNextFrameRendering());
        }

        // Il metodo per svuotare lo schermo quando si ferma la canzone
        public void ClearScreen()
        {
            lock (_syncLock) { _pendingPixels = null; }
            Avalonia.Threading.Dispatcher.UIThread.Post(() => RequestNextFrameRendering());
        }

        protected override unsafe void OnOpenGlRender(GlInterface gl, int fb)
        {
            if (_gl == null) return;
            try
            {
                _gl.Viewport(0, 0, (uint)Bounds.Width, (uint)Bounds.Height);
                _gl.ClearColor(0, 0, 0, 1);
                _gl.Clear(ClearBufferMask.ColorBufferBit);

                if (!_shadersReady || _textureId == 0) return;

                if (_pendingPixels != null)
                {
                    lock (_syncLock)
                    {
                        _gl.ActiveTexture(TextureUnit.Texture0);
                        _gl.BindTexture(TextureTarget.Texture2D, _textureId);
                        _gl.PixelStore(PixelStoreParameter.UnpackAlignment, 1);

                        fixed (byte* p = _pendingPixels)
                        {
                            _gl.TexImage2D(
                                TextureTarget.Texture2D, 0, (int)InternalFormat.Rgb,
                                (uint)_vidWidth, (uint)_vidHeight,
                                0, PixelFormat.Rgb, PixelType.UnsignedByte, p
                            );
                        }
                    }
                }

                _gl.UseProgram(_program);
                _gl.BindVertexArray(_vao);
                _gl.ActiveTexture(TextureUnit.Texture0);
                _gl.BindTexture(TextureTarget.Texture2D, _textureId);
                
                int loc = _gl.GetUniformLocation(_program, "uTexture");
                if (loc >= 0) _gl.Uniform1(loc, 0);

                _gl.DrawArrays(PrimitiveType.TriangleStrip, 0, 4);
                _gl.BindVertexArray(0);
            }
            catch { }
        }

        protected override void OnOpenGlDeinit(GlInterface gl)
        {
            if (_gl != null && _shadersReady)
            {
                _gl.DeleteTexture(_textureId);
                _gl.DeleteProgram(_program);
                _gl.DeleteVertexArray(_vao);
                _gl.DeleteBuffer(_vbo);
            }
            base.OnOpenGlDeinit(gl);
        }
    }
}
